# ============================================================
# Meal Canvas / 营养餐盘设计师 — 忽略规则
# 原则：原始数据、生成数据库、导出物、缓存一律不入库
# ============================================================

# ---------- 操作系统与编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
/build/
/backend/build/
*.egg-info/

# ---------- Node / 前端 ----------
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 环境变量与密钥 ----------
.env
.env.*
!.env.example

# ---------- 原始 USDA 数据 ----------
# 四个 ZIP 位于工作区外的 ../数据集，如需本地缓存也禁止入库
data/raw/*
!data/raw/.gitkeep
*.zip
!data/curation/*.csv

# ---------- 生成数据库与构建产物 ----------
data/build/*
!data/build/.gitkeep
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# ---------- 数据文件（白名单：仅人工维护的中文映射层）----------
*.csv
*.xlsx
!data/curation/*.csv

# ---------- 日志、临时文件与导出 ----------
*.log
tmp/
temp/
.tmp/
*.tmp
exports/
playwright-report/
test-results/
coverage/
